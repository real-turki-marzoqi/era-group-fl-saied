<?xml version="1.0" encoding="UTF-8"?>

<templates id="template" xml:space="preserve">

    <t t-name="era_whatsapp_pos.TicketScreen" t-inherit="point_of_sale.TicketScreen" t-inherit-mode="extension">
        <xpath expr="//InvoiceButton" position="after">
            <button t-if="pos.config.whatsapp_enabled"
                    class="control-button btn btn-light btn-lg lh-lg flex-grow-1 flex-shrink-1"
                    t-on-click="onClickSendWhatsapp">
                <i class="fa fa-whatsapp me-1" role="img" aria-label="whatsapp" title="whatsapp" />
                        WhatsApp
	        </button>
        </xpath>
    </t>


</templates>
