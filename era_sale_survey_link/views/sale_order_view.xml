<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_order_form_open_survey_btn" model="ir.ui.view">
    <field name="name">sale.order.form.open.survey.button</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_order_form"/>
    <field name="arch" type="xml">
      <!-- زر في الهيدر -->
      <xpath expr="//header" position="inside">

        <button name="action_open_related_survey"
                type="object"
                string="Answer Survey"
                class="btn-primary"/>

      </xpath>
    </field>
  </record>

</odoo>
