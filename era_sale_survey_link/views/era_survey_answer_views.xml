<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="era_survey_answer_view_form" model="ir.ui.view">
        <field name="name">era.survey.answer.view.form</field>
        <field name="model">era.survey.answer</field>
        <field name="arch" type="xml">
            <form string="Survey Answer" create="false">
                <header>

                    <button name="action_done" string="Mark as Done"
                            type="object" class="btn-primary"
                            invisible="state != 'in_progress'"
                            confirm="Are you sure you want to finalize this survey and create user input records?"/>

                    <button name="action_in_progress"
                            string="Start Survey"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'new'"/>


                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group col="2">
                        <group>
                            <field name="survey_id"
                                   options="{'no_edit': True, 'no_create': True, 'no_open': True}"/>
                            <field name="create_date"/>
                        </group>
                        <group>
                            <field name="partner_id"
                                   options="{'no_edit': True, 'no_create': True, 'no_open': True}"/>
                            <field name="email" widget="email"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Answers" name="page_answers">
                            <field name="line_ids" mode="list" no_label="1">
                                <list create="false" decoration-success="is_saved" decoration-danger="not is_saved">
                                    <field name="question_sequence" column_invisible="True"/>
                                    <field name="create_date" optional="hidden"/>
                                    <field name="question_id"/>
                                    <field name="answer_type" optional="hidden"/>
                                    <field name="display_name" string="Answer"/>
                                    <field name="is_saved" column_invisible="True"/>
                                </list>
                                <form string="User input line details" create="false">
                                    <sheet>
                                        <group col="4">
                                            <field name="question_id"
                                                   options="{'no_edit': True, 'no_create': True, 'no_open': True}"
                                                   readonly="1"/>
                                            <field name="create_date" readonly="1"/>
                                            <field name="answer_type" readonly="1"/>
                                            <field name="is_saved" invisible="1"/>
                                        </group>
                                        <group>
                                            <field name="value_char_box"
                                                   readonly="parent.state in ('new', 'done')"
                                                   colspan='2' invisible="answer_type != 'char_box'"/>

                                            <field name="value_numerical_box"
                                                   readonly="parent.state in ('new', 'done')"
                                                   colspan='2' invisible="answer_type != 'numerical_box'"/>
                                            <field name="value_date"
                                                   readonly="parent.state in ('new', 'done')"
                                                   colspan='2' invisible="answer_type != 'date'"/>
                                            <field name="value_datetime"
                                                   readonly="parent.state in ('new', 'done')"
                                                   colspan='2' invisible="answer_type != 'datetime'"/>
                                            <field name="value_text_box"
                                                   readonly="parent.state in ('new', 'done')"
                                                   colspan='2' invisible="answer_type != 'text_box'"/>
                                            <field name="matrix_row_id"
                                                   invisible="answer_type != 'suggestion'"
                                                   options="{'no_edit': True, 'no_create': True, 'no_open': True}"
                                                   readonly="1"
                                                   colspan='2' />
                                            <field name="suggested_answer_id"
                                                   readonly="parent.state in ('new', 'done')"
                                                   invisible="answer_type != 'suggestion'"
                                                   options="{'no_edit': True, 'no_create': True, 'no_open': True}"
                                                   domain="[('question_id', '=', question_id)]"
                                                   colspan='2'/>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="era_survey_answer_view_tree" model="ir.ui.view">
        <field name="name">era.survey.answer.view.list</field>
        <field name="model">era.survey.answer</field>
        <field name="arch" type="xml">
            <list string="Survey User inputs" create="false">
                <field name="create_date"/>
                <field name="survey_id"/>
                <field name="partner_id" optional="show"/>
                <field name="email" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state == 'new'"
                       decoration-warning="state == 'in_progress'"/>
            </list>
        </field>
    </record>

    <record id="action_era_survey_answer" model="ir.actions.act_window">
        <field name="name">Survey Answer</field>
        <field name="res_model">era.survey.answer</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="era_survey_answer_view_tree"></field>
    </record>

</odoo>
