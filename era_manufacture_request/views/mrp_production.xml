<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="era_mrp_production_branch_form_view" model="ir.ui.view">
        <field name="name">era.mrp.production.branch.form.view</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="branch_id" readonly="1" options="{'no_create': True, 'no_open': True}"/>
            </xpath>

            <xpath expr="//div[@name='button_box']" postion="inside">
                <button class="oe_stat_button" name="action_branch_picking" type="object" icon="fa-truck"
                        invisible="not branch_id">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">Branch Picking</span>
                    </div>
                </button>
            </xpath>

        </field>
    </record>

    <record id="era_mrp_production_branch_tree_view" model="ir.ui.view">
        <field name="name">era.mrp.production.branch.tree.view</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_tree_view"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="branch_id"/>
            </field>
        </field>
    </record>


    <record id="era_mrp_production_branch_filter_view" model="ir.ui.view">
        <field name="name">era.mrp.production.branch.filter.view</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.view_mrp_production_filter"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='name']" position="after">
                <field name="branch_id" string="Branch" filter_domain="[('branch_id.name', 'ilike', self)]"/>
            </xpath>

            <filter name="groupby_reservation_state" position="after">
                <filter string="Branch" name="groupby_branch_id" domain="[]" context="{'group_by': 'branch_id'}"/>
            </filter>

        </field>
    </record>

</odoo>
