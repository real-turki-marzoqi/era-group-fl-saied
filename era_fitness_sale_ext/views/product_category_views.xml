<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_category_form_add_appear_in_quotation" model="ir.ui.view">
        <field name="name">product.category.form.add.appear.in.quotation</field>
        <field name="model">product.category</field>
        <!-- نرث من نفس الفيو اللي ذكرتَه -->
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <!-- إدراج الحقل تحت property_account_downpayment_categ_id -->
            <xpath expr="//field[@name='parent_id']" position="after">


                <field name="appear_in_quotation"/>
                <field name="appear_in_crm"/>
                <field name="manager_ids" widget="many2many_tags" options="{'no_create': True}" />


                <field name="delivery_code" groups="era_fitness_sale_ext.group_add_category_code"/>
                <field name="installation_code" groups="era_fitness_sale_ext.group_add_category_code"/>
                <field name="consultation_code" groups="era_fitness_sale_ext.group_add_category_code"/>


            </xpath>
        </field>
    </record>
</odoo>
