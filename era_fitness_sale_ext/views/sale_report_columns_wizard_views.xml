<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_sale_report_columns_wizard_form" model="ir.ui.view">
    <field name="name">sale.report.columns.wizard.form</field>
    <field name="model">sale.report.columns.wizard</field>
    <field name="arch" type="xml">
      <form string="Choose Columns">
        <group>
          <group>
            <field name="sale_id" invisible="1"/>
            <field name="show_image"/>
            <field name="show_brand"/>
            <field name="show_warranty"/>
          </group>
          <group>
            <field name="show_qty"/>
            <field name="show_discount"/>
            <field name="show_amount"/>
          </group>
        </group>
        <footer>
          <button string="Cancel" class="btn-secondary" special="cancel"/>
          <button string="Print" type="object" name="action_print" class="btn-primary"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="action_open_sale_report_columns_wizard" model="ir.actions.act_window">
    <field name="name">Choose Columns</field>
    <field name="res_model">sale.report.columns.wizard</field>
    <field name="view_mode">form</field>
    <field name="view_id" ref="view_sale_report_columns_wizard_form"/>
    <field name="target">new</field>
    <field name="context">{'default_sale_id': active_id}</field>
  </record>

  <!-- زر في sale.order -->
  <record id="sale_order_form_inherit_custom_print" model="ir.ui.view">
    <field name="name">sale.order.form.custom.print.columns</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_order_form"/>
    <field name="arch" type="xml">
      <xpath expr="//button[@name='action_quotation_send']" position="after">
        <button name="%(action_open_sale_report_columns_wizard)d" type="action"
                class="btn-secondary" string="Print (Custom)"/>
      </xpath>
    </field>
  </record>
</odoo>
