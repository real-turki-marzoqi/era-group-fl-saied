<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_form_inherit_brand" model="ir.ui.view">
        <field name="name">product.template.form.inherit.brand</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <!-- نضيف الحقل تحت التصنيف مباشرة -->
            <xpath expr="//field[@name='categ_id']" position="after">
    <field name="brand_id" options="{'no_create_edit': False}"/>
    <field name="warranty_period" readonly="1"/>
</xpath>

        </field>
    </record>

